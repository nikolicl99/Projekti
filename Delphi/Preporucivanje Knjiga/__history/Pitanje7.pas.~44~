function TfrmPitanje7.ProveraNizaGodineOpseg(const OriginalniNiz: TArray<Integer>; const StartYear, EndYear: Integer): TArray<Integer>;
var
  MyQuery: TFDQuery;
  ResultArray: TArray<Integer>;
  i: Integer;
  KnjigaID: Integer;
begin
  SetLength(ResultArray, 0);

  MyQuery := TFDQuery.Create(nil);
  try
    MyQuery.Connection := GlobalConnection;
    MyQuery.SQL.Text := 'SELECT IDKnjige FROM Knjige WHERE Godina_Izdavanja BETWEEN :StartYear AND :EndYear';
    MyQuery.ParamByName('StartYear').AsInteger := StartYear;
    MyQuery.ParamByName('EndYear').AsInteger := EndYear;
    MyQuery.FetchOptions.Mode := fmAll;
    MyQuery.FetchOptions.RecsMax := -1;
    MyQuery.Open;

    while not MyQuery.Eof do
    begin
      KnjigaID := MyQuery.FieldByName('IDKnjige').AsInteger;
SetLength(ResultArray, Length(ResultArray) + 1);
      ResultArray[Length(ResultArray) - 1] := KnjigaID;
      MyQuery.Next;
    end;
  finally
    MyQuery.Free;
  end;

  Result := ResultArray;
end;


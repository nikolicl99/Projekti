function TfrmPitanje8Lokacija.ProveraNizaLokacija(const idLokacije: integer; const OriginalniNiz: TArray<Integer>): TArray<Integer>;
var
  MyQuery: TFDQuery;
  ResultArray: TArray<Integer>;
  i: Integer;
  KnjigaID: integer;
begin
  SetLength(ResultArray, 0);

  MyQuery := TFDQuery.Create(nil);
  try
    MyQuery.Connection := GlobalConnection;
    MyQuery.SQL.Text := 'SELECT IDKnjige FROM Lokacija_Knjige WHERE IDLokacije = :Lokacija';
    MyQuery.ParamByName('Lokacija').AsInteger := idLokacije;
    MyQuery.Open;

    ShowMessage('Broj elemenata u OriginalniNiz: ' + Length(OriginalniNiz).ToString);
    ShowMessage('Broj Clanova kverija: ' + MyQuery.RecordCount.ToString);

    while not MyQuery.Eof do
    begin
      KnjigaID := MyQuery.FieldByName('IDKnjige').AsInteger;

      for i := Low(OriginalniNiz) to High(OriginalniNiz) do
      begin
        if KnjigaID = OriginalniNiz[i] then
        begin
          SetLength(ResultArray, Length(ResultArray) + 1);
          ResultArray[Length(ResultArray) - 1] := KnjigaID;
          Break;
        end;
      end;

      MyQuery.Next;
    end;
  finally
    MyQuery.Free;
  end;

  Result := ResultArray;
end;

function TfrmPitanje8Lokacija.GetIDLokacije(const imeLokacije: string): Integer;
var
  MyQuery: TFDQuery;
begin
  Result := -1;
  MyQuery := TFDQuery.Create(nil);
  try
    MyQuery.Connection := GlobalConnection;
    MyQuery.SQL.Text := 'SELECT IDLokacije FROM Lokacija WHERE Naziv = :Lokacija';
    MyQuery.ParamByName('Lokacija').AsWideString := imeLokacije;
    MyQuery.Open;

    if not MyQuery.IsEmpty then
      Result := MyQuery.FieldByName('IDLokacije').AsInteger;
  finally
    MyQuery.Free;
  end;
end;

end.


end;

procedure TfrmPitanje8Lokacija.Lokacija_EditChangeTracking(Sender: TObject);
var
  MyQuery: TFDQuery;
  Row: Integer;
begin
  MyQuery := TFDQuery.Create(nil);
  try
    MyQuery.Connection := GlobalConnection;
    MyQuery.SQL.Text := 'SELECT * FROM Lokacija WHERE Naziv LIKE :Naziv ORDER BY Naziv';
    MyQuery.ParamByName('Naziv').AsWideString := Lokacija_Edit.Text + '%';
    MyQuery.Open;

    Lokacija.RowCount := 1;
    Row := 0;
    while not MyQuery.Eof do
    begin
      Lokacija.RowCount := Lokacija.RowCount + 1;
      Lokacija.Cells[0, Row] := MyQuery.FieldByName('Naziv').AsString;
      Inc(Row);
      MyQuery.Next;
    end;
  finally
    MyQuery.Free;
  end;
end;


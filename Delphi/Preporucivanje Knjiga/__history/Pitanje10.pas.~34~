procedure TfrmPitanje10.FormActivate(Sender: TObject);
var
  MyQuery: TFDQuery;
begin
  Left := Round((Screen.Width - Width) / 2);
  Top := Round((Screen.Height - Height) / 2);
  MyQuery := TFDQuery.Create(nil);
  try
    MyQuery.Connection := GlobalConnection;
    MyQuery.SQL.Text := 'SELECT * FROM Jezici ORDER BY Jezik';
    // Podešavanje FetchOptions za brže učitavanje podataka
    MyQuery.FetchOptions.Mode := fmAll;
    MyQuery.FetchOptions.Items := [fiBlobs];
    MyQuery.Open;
    Jezik.Items.Clear;
    while not MyQuery.Eof do
    begin
      Jezik.Items.Add(MyQuery.FieldByName('Jezik').AsString);
      MyQuery.Next;
    end;
  finally
    MyQuery.Free;
  end;
end;


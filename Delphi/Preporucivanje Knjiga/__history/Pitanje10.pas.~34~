function TfrmPitanje10.GetIDJezika(const imeJezika: string): Integer;
var
  MyQuery: TFDQuery;
begin
  Result := -1;
  MyQuery := TFDQuery.Create(nil);
  try
    MyQuery.Connection := GlobalConnection;
    MyQuery.SQL.Text := 'SELECT IDJezika FROM Jezici WHERE Jezik = :Naziv';
    MyQuery.ParamByName('Naziv').AsWideString := imeJezika;
    MyQuery.Open;

    if not MyQuery.IsEmpty then
      Result := MyQuery.FieldByName('IDJezika').AsInteger;
  finally
    MyQuery.Free;
  end;
end;


end;

procedure TfrmPitanje9Vreme.Period_EditChangeTracking(Sender: TObject);
var
  MyQuery: TFDQuery;
  Row: Integer;
begin
  MyQuery := TFDQuery.Create(nil);
  try
    MyQuery.Connection := GlobalConnection;
    MyQuery.SQL.Text := 'SELECT * FROM Vreme WHERE Vreme LIKE :Vreme ORDER BY Vreme';
    MyQuery.ParamByName('Vreme').AsWideString := Period_Edit.Text + '%';
    MyQuery.Open;

    Period.RowCount := 1;
    Row := 0;
    while not MyQuery.Eof do
    begin
      Period.RowCount := Period.RowCount + 1;
      Period.Cells[0, Row] := MyQuery.FieldByName('Vreme').AsString;
      Inc(Row);
      MyQuery.Next;
    end;
  finally
    MyQuery.Free;
  end;
end;

function TfrmPitanje9Vreme.GetIDPerioda(const imePeriod: string): Integer;
var
  MyQuery: TFDQuery;
begin
  Result := -1;
  MyQuery := TFDQuery.Create(nil);
  try
    MyQuery.Connection := GlobalConnection;
    MyQuery.SQL.Text := 'SELECT IDVremena FROM Vreme WHERE Vreme = :Period';
    MyQuery.ParamByName('Period').AsWideString := imePeriod;
    MyQuery.Open;

    if not MyQuery.IsEmpty then
      Result := MyQuery.FieldByName('IDVremena').AsInteger;
  finally
    MyQuery.Free;
  end;
end;


procedure TfrmPitanje2Tema.PopuniStringGridSaTemama;
var
  Query: TFDQuery; // Promenjena promenljiva na Query
  Row: Integer;
  TemeInGrid: TArray<string>;
  TemeCount: Integer;
begin
  Query := TFDQuery.Create(nil); // Promenjena promenljiva na Query
  try
    Query.Connection := GlobalConnection;
    Query.SQL.Text :=
      'SELECT DISTINCT Teme.Naziv_Teme ' +
      'FROM Teme ' +
      'JOIN Tema_Knjige ON Teme.IDTeme = Tema_Knjige.IDTeme ' +
      'WHERE Tema_Knjige.IDKnjige IN (' + JoinToString(frmPitanje2Podzanr.NizPitanje2Podzanr) + ') ' +
      'ORDER BY Teme.Naziv_Teme';

    // Postavite FetchOptions pre dohvatanja podataka
    Query.FetchOptions.Mode := fmOnDemand; // Dohvati podatke po potrebi
    Query.FetchOptions.RecordCountMode := cmTotal; // Uzmi ukupan broj zapisa

    Query.Open;

    TemeCount := Query.RecordCount; // Promenjeno da koristi Query.RecordCount

    SetLength(TemeInGrid, TemeCount);
    Row := 0;

    while not Query.Eof do
    begin
      TemeInGrid[Row] := Query.FieldByName('Naziv_Teme').AsString;
      Inc(Row);
      Query.Next;
    end;

    Teme.RowCount := TemeCount + 1;
    for Row := 0 to TemeCount - 1 do
    begin
      Teme.Cells[0, Row] := TemeInGrid[Row];
    end;
  finally
    Query.Free;
    Teme.RowCount := Teme.RowCount - 1; // Izmenjeno da smanji broj redova za 1
  end;
end;



function TfrmPitanje2Tema.JoinToString(const Arr: TArray<Integer>): string;
var
  Value: Integer;
begin
  Result := '';
  for Value in Arr do
  begin
    if Result <> '' then
      Result := Result + ', ';
    Result := Result + IntToStr(Value);
  end;
end;

function TfrmPitanje2Tema.ProveraNizaTema(const SelectedTema: Integer; const OriginalniNiz: TArray<Integer>): TArray<Integer>;
var
  MyQuery: TFDQuery;
  ResultArray: TArray<Integer>;
  j, h: Integer;
//  Found: Boolean;
  SelectedTeme: TArray<Integer>;
  Red: integer;
  KnjigaID, KnjigaIndex: integer;
  FoundMatch: Boolean; // Dodata promenljiva
begin
  SetLength(ResultArray, 0);

  ShowMessage('Broj elemenata u OriginalniNiz: ' + Length(OriginalniNiz).ToString);

//  Found := False;
  FoundMatch := False; // Inicijalizacija promenljive

  for j := Low(OriginalniNiz) to High(OriginalniNiz) do
  begin
    MyQuery := TFDQuery.Create(nil);
    try
      MyQuery.Connection := GlobalConnection;
      MyQuery.SQL.Text := 'SELECT * FROM Tema_Knjige WHERE IDKnjige = :Knjiga';
      MyQuery.ParamByName('Knjiga').AsInteger := OriginalniNiz[j];
      MyQuery.Open;

      if not MyQuery.IsEmpty then
      begin
        setLength(SelectedTeme, MyQuery.RecordCount);
        Red := 0;

        while not MyQuery.Eof do
        begin
          SelectedTeme[Red] := MyQuery.FieldByName('IDTeme').AsInteger;
//          showMessage('Tema u nizu: ' + SelectedTeme[Red].ToString);
          Inc(Red);
          MyQuery.Next;
        end;
      end;
    finally
      MyQuery.Free;
    end;

    for h := Low(SelectedTeme) to High(SelectedTeme) do
    begin
//      ShowMessage('Proveravam ' + SelectedTema.ToString + ' sa ' + SelectedTeme[h].ToString);

      if SelectedTema = SelectedTeme[h] then
      begin
        KnjigaID := OriginalniNiz[j];

        // Provera da li KnjigaID već postoji u rezultatskom nizu
        for KnjigaIndex := Low(ResultArray) to High(ResultArray) do
        begin
          if KnjigaID = ResultArray[KnjigaIndex] then
          begin
            KnjigaID := -1; // Postavi na -1 ako je već prisutna
            Break;
          end;
        end;

        // Dodaj KnjigaID u rezultatski niz ako nije već prisutna
        if KnjigaID <> -1 then
        begin
//          showMessage('Uneta knjiga sa id: ' + SelectedTema.ToString);
          SetLength(ResultArray, Length(ResultArray) + 1);
          ResultArray[Length(ResultArray) - 1] := KnjigaID;

          FoundMatch := True; // Postavi na True kada pronađeš poklapanje
        end;
      end;
    end;
  end;

  // Provera da li postoji poklapanje za trenutnu temu
  if not FoundMatch then
//    ShowMessage('Nema poklapanja za temu ' + SelectedTema.ToString);

  ShowMessage('Broj elemenata u rezultatskom nizu: ' + Length(ResultArray).ToString);
  Result := ResultArray;
end;



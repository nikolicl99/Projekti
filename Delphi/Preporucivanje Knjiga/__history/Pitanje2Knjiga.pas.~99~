procedure TfrmPitanje2Knjiga.Knjiga_EditChangeTracking(Sender: TObject);
var
  MyQuery: TFDQuery;
  Row: Integer;
begin
  MyQuery := TFDQuery.Create(nil);
  try
    MyQuery.Connection := GlobalConnection;
    MyQuery.SQL.Text := 'SELECT * FROM Knjige WHERE Naziv LIKE :Knjiga ORDER BY Naziv';
    MyQuery.ParamByName('Knjiga').AsWideString := Knjiga_Edit.Text + '%';
    MyQuery.Open;

    Knjiga.RowCount := 1;
    Row := 0;
    while not MyQuery.Eof do
    begin
      Knjiga.RowCount := Knjiga.RowCount + 1;
      Knjiga.Cells[0, Row] := MyQuery.FieldByName('Naziv').AsString;
      Inc(Row);
      MyQuery.Next;
    end;
  finally
    MyQuery.Free;
  end;
end;

function TfrmPitanje2Knjiga.ProveraNizaPodzanr(const idPodzanra: Integer; const OriginalniNiz: TArray<Integer>): TArray<Integer>;
var
  MyQuery: TFDQuery;
  ResultArray: TArray<Integer>;
  i: Integer;
begin
  SetLength(ResultArray, 0);
  MyQuery := TFDQuery.Create(nil);
  try
    MyQuery.Connection := GlobalConnection;
    MyQuery.SQL.Text := 'SELECT IDKnjige FROM Knjige WHERE Podzanr = :Podzanr';
    MyQuery.ParamByName('Podzanr').AsInteger := idPodzanra;
    MyQuery.Open;
    while not MyQuery.Eof do
    begin
      if TArray.BinarySearch<Integer>(OriginalniNiz, MyQuery.FieldByName('IDKnjige').AsInteger, i) then
      begin
        SetLength(ResultArray, Length(ResultArray) + 1);
        ResultArray[High(ResultArray)] := MyQuery.FieldByName('IDKnjige').AsInteger;
      end;
      MyQuery.Next;
    end;
  finally
    MyQuery.Free;
  end;
  Result := ResultArray;
end;

function TfrmPitanje2Knjiga.ProveraNizaTema(const NizTema: TArray<Integer>; const OriginalniNiz: TArray<Integer>): TArray<Integer>;
var
  MyQuery: TFDQuery;
  ResultArray: TArray<Integer>;
  i, j: Integer;
  TemeSet: TDictionary<Integer, Boolean>;
  KnjigaID: Integer;
begin
  SetLength(ResultArray, 0);
  TemeSet := TDictionary<Integer, Boolean>.Create;
  try
    for i := Low(NizTema) to High(NizTema) do
      TemeSet.AddOrSetValue(NizTema[i], True);

    MyQuery := TFDQuery.Create(nil);
    try
      MyQuery.Connection := GlobalConnection;
      MyQuery.SQL.Text := 'SELECT IDKnjige, IDTeme FROM Tema_Knjige';
      MyQuery.Open;
      while not MyQuery.Eof do
      begin
        KnjigaID := MyQuery.FieldByName('IDKnjige').AsInteger;
        if TemeSet.ContainsKey(MyQuery.FieldByName('IDTeme').AsInteger) and TArray.BinarySearch<Integer>(OriginalniNiz, KnjigaID, j) then
        begin
          SetLength(ResultArray, Length(ResultArray) + 1);
          ResultArray[High(ResultArray)] := KnjigaID;
        end;
        MyQuery.Next;
      end;
    finally
      MyQuery.Free;
    end;
  finally
    TemeSet.Free;
  end;
  Result := ResultArray;
end;

function TfrmPitanje2Knjiga.GetIDKnjige(const imeKnjige: string): Integer;
var
  MyQuery: TFDQuery;
begin
  MyQuery := TFDQuery.Create(nil);
  try
    MyQuery.Connection := GlobalConnection;
    MyQuery.SQL.Text := 'SELECT IDKnjige FROM Knjige WHERE Naziv = :Naziv';
    MyQuery.ParamByName('Naziv').AsString := imeKnjige;
    MyQuery.Open;
    Result := MyQuery.FieldByName('IDKnjige').AsInteger;
  finally
    MyQuery.Free;
  end;
end;

function TfrmPitanje2Knjiga.RemoveFromArray(const AArray: TArray<Integer>; const Value: Integer): TArray<Integer>;
var
  i, j: Integer;
begin
  SetLength(Result, Length(AArray) - 1);
  j := 0;
  for i := Low(AArray) to High(AArray) do
  begin
    if AArray[i] <> Value then
    begin
      Result[j] := AArray[i];
      Inc(j);
    end;
  end;
end;

end.

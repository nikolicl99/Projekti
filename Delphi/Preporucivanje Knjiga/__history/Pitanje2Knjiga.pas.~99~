procedure TfrmPitanje2Knjiga.FormActivate(Sender: TObject);
var
  MyQuery: TFDQuery;
  Row: Integer;
begin
  Knjiga_Edit.Text := '';
  SelectedKnjiga := 0;
  Left := Round((Screen.Width - Width)/2);
  Top := Round ((Screen.Height - Height)/2);
  MyQuery := TFDQuery.Create(nil);
  try
    MyQuery.Connection := GlobalConnection;
    if frmPitanje1.Pitanje1ID = 1 then
    begin
      MyQuery.SQL.Text := 'SELECT DISTINCT Naziv FROM Knjige WHERE Autor = :Autor ORDER BY Naziv';
      MyQuery.ParamByName('Autor').AsInteger := frmPitanje1Autor.SelectedAutor;
    end
    else if frmPitanje1.Pitanje1ID = 2 then
    begin
      MyQuery.SQL.Text := 'SELECT DISTINCT Naziv FROM Knjige ORDER BY Naziv';
    end;
    MyQuery.FetchOptions.Mode := fmAll;
    MyQuery.FetchOptions.RecsMax := -1;
    MyQuery.Open;

    Knjiga.RowCount := 1;
    Row := 0;
    while not MyQuery.Eof do
    begin
      Knjiga.RowCount := Knjiga.RowCount + 1;
      Knjiga.Cells[0, Row] := MyQuery.FieldByName('Naziv').AsString;
      Inc(Row);
      MyQuery.Next;
    end;
  finally
    Knjiga.RowCount := Knjiga.RowCount - 1;
    MyQuery.Free;
  end;
end;

procedure TfrmPitanje2Knjiga.FormClose(Sender: TObject; var Action: TCloseAction);
begin
  Application.Terminate;
end;


var
  MyQuery: TFDQuery;
begin
  Result := '';
  MyQuery := TFDQuery.Create(nil);
  try
    MyQuery.Connection := GlobalConnection;
    MyQuery.SQL.Text := 'SELECT Naziv_Teme FROM Teme WHERE IDTeme = :Tema';

var
  MyQuery: TFDQuery;
begin
  Result := '';
  MyQuery := TFDQuery.Create(nil);
  try
    MyQuery.Connection := GlobalConnection;
    MyQuery.SQL.Text := 'SELECT NazivPodzanra FROM Podzanr WHERE IDPodzanra = :Podzanr';
    MyQuery.ParamByName('Podzanr').AsInteger := idPodzanra;
    MyQuery.Open;

    if not MyQuery.IsEmpty then
      Result := MyQuery.FieldByName('NazivPodzanra').AsString;
  finally
    MyQuery.Free;
  end;
end;


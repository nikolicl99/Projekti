unit Vise;

interface

uses
  System.SysUtils, System.Types, System.UITypes, System.Classes, System.Variants,
  FMX.Types, FMX.Controls, FMX.Forms, FMX.Graphics, FMX.Dialogs,
  FMX.Controls.Presentation, FMX.StdCtrls, System.Rtti, FMX.Grid.Style,
  FMX.Grid, FMX.ScrollBox, FMX.Edit, FireDAC.Stan.Intf, FireDAC.Stan.Option,
  FireDAC.Stan.Param, FireDAC.Stan.Error, FireDAC.DatS, FireDAC.Phys.Intf,
  FireDAC.DApt.Intf, FireDAC.Stan.Async, FireDAC.DApt, Data.DB,
  FireDAC.Comp.DataSet, FireDAC.Comp.Client;

type
  TFrmVise = class(TForm)
    Forma: TPanel;
    StyleBook: TStyleBook;
    StyleBook1: TStyleBook;
    Podzanr_Edit: TEdit;
    Strane_Edit: TEdit;
    Teme: TStringGrid;
    Teme_col: TStringColumn;
    procedure FormActivate(Sender: TObject);
  private
    { Private declarations }
    Row: Integer;
    function GetPodzanrKnjige(const idKnjige: Integer): Integer;
    function GetPodzanrNaziv(const idPodzanra: Integer): String;
    function GetStraneKnjige(const idKnjige: Integer): String;
    function GetTemaNaziv(const idTeme: Integer): String;
  public
    { Public declarations }
  end;

var
  FrmVise: TFrmVise;

implementation

{$R *.fmx}
uses Main;

procedure TFrmVise.FormActivate(Sender: TObject);
var
MyQuery: TFDQuery;
begin
Left := Round(((Screen.Width - Width) / 2) - 480);
Top := Round((Screen.Height - Height) / 2);
Podzanr_Edit.Text := GetPodzanrNaziv(GetPodzanrKnjige(frmMain.CurrentBookID));
Strane_Edit.Text := GetStraneKnjige(frmMain.CurrentBookID);
MyQuery := TFDQuery.Create(nil);
try
  MyQuery.Connection := GlobalConnection;
  MyQuery.SQL.Text := 'SELECT * FROM Tema_Knjige WHERE IDKnjige = :Knjiga';
  MyQuery.ParamByName('Knjiga').AsInteger := frmMain.CurrentBookID;
  MyQuery.Open;
  Teme.RowCount := 1;
    Row := 0;
    while not MyQuery.Eof do
    begin
      Teme.RowCount := Teme.RowCount + 1;
      Teme.Cells[0, Row] := GetTemaNaziv(MyQuery.FieldByName('Naziv_Teme').AsInteger);
      Inc(Row);
      MyQuery.Next;
    end;
finally
  MyQuery.Free;
  Teme.RowCount := Teme.RowCount - 1;
end;
end;

function TfrmVise.GetPodzanrKnjige(const idKnjige: Integer): Integer;
var
  MyQuery: TFDQuery;
begin
  Result := -1;
  MyQuery := TFDQuery.Create(nil);
  try
    MyQuery.Connection := GlobalConnection;
    MyQuery.SQL.Text := 'SELECT Podzanr FROM Knjige WHERE IDKnjige = :Knjiga';
    MyQuery.ParamByName('Knjiga').AsInteger := idKnjige;
    MyQuery.Open;

    if not MyQuery.IsEmpty then
      Result := MyQuery.FieldByName('Podzanr').AsInteger;
  finally
    MyQuery.Free;
  end;
end;

